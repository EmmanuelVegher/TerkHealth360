// ── Global Interoperability & Terminology Data Dictionary ───────────────────
model TerminologyConcept {
  id          String        @id @default(uuid())
  system      String        // "LOINC" | "ICD10" | "SNOMED" | "RXNORM" | "CPT" | "ISBT128"
  code        String
  display     String
  description String?
  category    String?       // "LAB", "DIAGNOSIS", "PHARMACY", "BILLING", "BLOOD_BANK", "VITAL"
  systemUri   String?       // e.g. "http://loinc.org", "http://hl7.org/fhir/sid/icd-10"
  isActive    Boolean       @default(true)
  mappings    CodeMapping[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([system, code])
  @@index([system, code])
  @@index([category])
  @@map("terminology_concepts")
}

model CodeMapping {
  id            String             @id @default(uuid())
  localItemType String             // "LAB_TEST", "PHARMACY_ITEM", "SERVICE_TARIFF", "DIAGNOSIS"
  localItemId   String
  conceptId     String
  concept       TerminologyConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  isPrimary     Boolean            @default(true)
  notes         String?
  createdAt     DateTime           @default(now())

  @@map("code_mappings")
}

// ─────────────────────────────────────────────────────────────────────────────
// OpenMed Agentic RAG — Institutional Memory (Persistent Chat)
// ─────────────────────────────────────────────────────────────────────────────

model AiChatConversation {
  id        String       @id @default(uuid())
  userId    String
  userRole  String
  title     String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns     AiChatTurn[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("ai_chat_conversations")
}

model AiChatTurn {
  id             String             @id @default(uuid())
  conversationId String
  sender         String             // "user" | "agent"
  text           String             @db.Text
  intent         String?
  toolsExecuted  String[]
  cardPayload    Json?
  patientContext Json?
  createdAt      DateTime           @default(now())
  conversation   AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_chat_turns")
}

