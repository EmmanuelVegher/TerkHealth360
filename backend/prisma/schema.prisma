generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(PATIENT)
  isActive            Boolean              @default(true)
  twoFactorEnabled    Boolean              @default(false)
  twoFactorSecret     String?
  twoFactorType       String               @default("NONE")
  emailOtpCode        String?
  emailOtpExpiresAt   DateTime?
  passwordExpiresAt   DateTime?
  passwordChangedAt   DateTime             @default(now())
  isTemporaryPassword Boolean              @default(false)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  profilePicture      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditLogs           AuditLog[]
  breakGlassLogs      BreakGlassLog[]
  DepartmentHistory   DepartmentHistory[]
  approvedEncounters  Encounter[]          @relation("EncounterApprover")
  passwordHistories   PasswordHistory[]
  passwordResetTokens PasswordResetToken[]
  createdPatients     Patient[]            @relation("PatientCreator")
  patient             Patient?
  refreshTokens       RefreshToken[]
  staff               Staff?
  departments         UserDepartment[]
  roles               UserRoleMapping[]
  aiChatConversations AiChatConversation[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(512)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Patient {
  id                           String                        @id @default(uuid())
  fhirId                       String?                       @unique
  userId                       String                        @unique
  patientNumber                String                        @unique
  firstName                    String
  lastName                     String
  middleName                   String?
  maidenName                   String?
  birthDate                    DateTime?
  gender                       Gender
  maritalStatus                MaritalStatus?
  bloodGroup                   BloodGroup?
  genotype                     String?
  nationality                  String?
  stateOfOrigin                String?
  lga                          String?
  occupation                   String?
  religion                     String?
  spokenLanguage               String?
  nin                          String?                       @unique
  photoUrl                     String?
  status                       String                        @default("ACTIVE")
  identification               String?
  isActive                     Boolean                       @default(true)
  openmrsUuid                  String?
  moniepointCustomerId         String?
  walletBalance                Decimal                       @default(0) @db.Decimal(12, 2)
  amountOwed                   Decimal                       @default(0) @db.Decimal(12, 2)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  familyAccountId              String?
  familyRelationship           String?
  nokName                      String?
  nokRelationship              String?
  nokPhone                     String?
  nokAddress                   String?
  emergencyName                String?
  emergencyPhone               String?
  emergencyRelationship        String?
  emergencyAddress             String?
  createdById                  String?
  admissions                   Admission[]
  allergies                    Allergy[]
  appointments                 Appointment[]
  bloodDonors                  BloodDonor[]
  transfusionRecords           BloodTransfusionRecord[]
  transfusionRequests          BloodTransfusionRequest[]
  cervicalScreenings           CervicalCancerScreening[]     @relation("CervicalScreenings")
  clinicalAlerts               ClinicalAlert[]
  clinicalAttachments          ClinicalAttachment[]
  discussions                  ClinicalDiscussion[]
  clinicalMessages             ClinicalMessage[]
  conditions                   Condition[]
  consultationNotes            ConsultationNote[]
  emarRecords                  EMARRecord[]
  emergencyArrivals            EmergencyArrival[]
  emergencyIncidentRecords     EmergencyIncidentRecord[]
  encounters                   Encounter[]
  familyPlanningEnrollments    FamilyPlanningEnrollment[]    @relation("FamilyPlanningEnrollments")
  fertilityAssessments         FertilityAssessment[]         @relation("FertilityAssessments")
  gynaecologyConsultations     GynaecologyConsultation[]     @relation("GynaecologyConsultations")
  gynaecologyProcedures        GynaecologyProcedure[]        @relation("GynaecologyProcedures")
  icuAdmissions                IcuAdmission[]
  icuDialysisLifeSupports      IcuDialysisLifeSupport[]
  icuDischargeHandovers        IcuDischargeHandover[]
  icuEarlyWarningAlerts        IcuEarlyWarningAlert[]
  icuIncidentRecords           IcuIncidentRecord[]
  icuInfusionTherapies         IcuInfusionTherapy[]
  icuNeurologicalObservations  IcuNeurologicalObservation[]
  icuPhysiologicalObservations IcuPhysiologicalObservation[]
  invoices                     Invoice[]
  labOrders                    LabOrder[]
  maternalDeathReviews         MaternalDeathReview[]         @relation("MaternalDeaths")
  maternityProfile             MaternityProfile?             @relation("MaternityProfile")
  medicalHistory               MedicalHistory?
  medicationRequests           MedicationRequest[]
  monnifyVirtualAccounts       MonnifyVirtualAccount[]
  neonatalMothers              NeonatalRecord[]              @relation("MotherBaby")
  nurseAssignments             NurseAssignment[]
  nursingCarePlans             NursingCarePlan[]
  nursingInterventions         NursingIntervention[]
  nursingTasks                 NursingTask[]
  observations                 Observation[]
  pacuRecoveries               PACURecoveryRecord[]
  addresses                    PatientAddress[]
  cardReprints                 PatientCardReprint[]
  feedbacks                    PatientFeedback[]
  identifiers                  PatientIdentifier[]
  insurancePolicies            PatientInsurancePolicy[]
  queues                       PatientQueue[]
  telecoms                     PatientTelecom[]
  createdBy                    User?                         @relation("PatientCreator", fields: [createdById], references: [id])
  familyAccount                FamilyAccount?                @relation(fields: [familyAccountId], references: [id])
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyADEs                 PharmacyADE[]
  pharmacyPrescriptions        PharmacyPrescription[]
  portalAccount                PortalAccount?
  preOpAssessments             PreOpAssessment[]
  pregnancyRecords             PregnancyRecord[]
  radiologyIncidents           RadiologyIncident[]
  radiologyOrders              RadiologyOrder[]
  referrals                    Referral[]
  handovers                    ShiftHandover[]
  surgicalBookings             SurgicalBooking[]
  consentForms                 SurgicalConsent[]
  surgicalRequests             SurgicalRequest[]
  telemedicineSessions         TelemedicineSession[]
  triageRecords                TriageRecord[]
  visits                       Visit[]

  @@index([familyAccountId])
  @@index([lastName, firstName])
  @@index([firstName])
  @@index([lastName])
  @@index([walletBalance])
  @@index([amountOwed])
  @@index([createdAt])
  @@index([status])
  @@index([status, isActive])
  @@map("patients")
}

model PatientIdentifier {
  id          String  @id @default(uuid())
  patientId   String
  system      String?
  value       String
  typeCode    String?
  typeDisplay String?
  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, system, value])
  @@map("patient_identifiers")
}

model MonnifyVirtualAccount {
  id                   String                     @id @default(uuid())
  patientId            String
  accountReference     String                     @unique
  accountName          String
  accountNumber        String?
  bankName             String?
  bankCode             String?
  reservationReference String?
  status               String                     @default("PENDING")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  createdById          String?
  patient              Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  transactions         MonnifyWalletTransaction[]

  @@index([patientId])
  @@map("monnify_virtual_accounts")
}

model MonnifyWalletTransaction {
  id                String                @id @default(uuid())
  virtualAccountId  String
  patientId         String
  transactionRef    String?               @unique
  amount            Decimal               @db.Decimal(12, 2)
  type              String
  status            String                @default("PENDING")
  narration         String?
  channel           String?
  bankName          String?
  sourceAccountName String?
  method            String                @default("MONNIFY")
  balanceBefore     Decimal               @default(0) @db.Decimal(12, 2)
  balanceAfter      Decimal               @default(0) @db.Decimal(12, 2)
  createdAt         DateTime              @default(now())
  processedAt       DateTime?
  notes             String?
  virtualAccount    MonnifyVirtualAccount @relation(fields: [virtualAccountId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([virtualAccountId])
  @@map("monnify_wallet_transactions")
}

model PatientTelecom {
  id        String        @id @default(uuid())
  patientId String
  system    TelecomSystem @default(phone)
  value     String
  use       TelecomUse?
  rank      Int?
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_telecoms")
}

model PatientAddress {
  id         String       @id @default(uuid())
  patientId  String
  line       String?
  city       String?
  district   String?
  state      String?
  postalCode String?
  country    String?
  use        AddressUse?
  type       AddressType?
  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_addresses")
}

model Staff {
  id                          String                         @id @default(uuid())
  userId                      String                         @unique
  employeeId                  String                         @unique
  firstName                   String
  lastName                    String
  department                  String?
  designation                 String?
  qualification               String?
  specialization              String?
  licenseNumber               String?
  isActive                    Boolean                        @default(true)
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  pharmacyRequisitions        PharmacyRequisition[]          @relation("RequisitionRequester")
  appointments                Appointment[]
  scientistCompatibilityTests BloodCompatibilityTest[]       @relation("CompatibilityScientist")
  technologistComponents      BloodComponent[]               @relation("ComponentProcessor")
  phlebotomistDonations       BloodDonation[]                @relation("DonationCollector")
  administeredTransfusions    BloodTransfusionRecord[]       @relation("TransfusionAdministrator")
  requestedTransfusions       BloodTransfusionRequest[]      @relation("TransfusionRequester")
  discussionComments          ClinicalDiscussionComment[]    @relation("CommentAuthor")
  discussionsCreated          ClinicalDiscussion[]           @relation("DiscussionCreator")
  receivedMessages            ClinicalMessage[]              @relation("MessageRecipient")
  sentMessages                ClinicalMessage[]              @relation("MessageSender")
  conditions                  Condition[]
  certifiedSterilizations     CSSDSterilizationCycle[]       @relation("CSSDOfficer")
  birthsAttended              DeliveryRecord[]               @relation("BirthAttendant")
  emarAdministered            EMARRecord[]                   @relation("EMARAdministeredBy")
  emergencyIncidentReports    EmergencyIncidentRecord[]      @relation("EmergencyIncidentReporter")
  emergencyObservations       EmergencyObservationLog[]      @relation("EmergencyObserver")
  emergencyProcedures         EmergencyProcedure[]           @relation("EmergencyOperator")
  emergencyStaffingShifts     EmergencyStaffingShift[]       @relation("EmergencyStaffClinician")
  traumaSurgeons              EmergencyTraumaTeam[]          @relation("TraumaSurgeon")
  traumaTeamsLed              EmergencyTraumaTeam[]          @relation("TraumaTeamLeader")
  encounters                  Encounter[]
  gynaecologyConsultations    GynaecologyConsultation[]      @relation("GynaecologyClinician")
  icuApprovedAdmissions       IcuAdmission[]                 @relation("IcuAdmittingClinician")
  icuDischargedHandovers      IcuDischargeHandover[]         @relation("IcuHandoverClinician")
  icuIncidentReporters        IcuIncidentRecord[]            @relation("IcuIncidentReporter")
  icuNeurologicalLogs         IcuNeurologicalObservation[]   @relation("IcuNeuroClinician")
  icuPhysiologicalLogs        IcuPhysiologicalObservation[]  @relation("IcuObservingClinician")
  icuStaffingShifts           IcuStaffingShift[]             @relation("IcuStaffClinician")
  labOrdersRequested          LabOrder[]                     @relation("LabOrderRequester")
  labResultsValidated         LabResult[]                    @relation("LabResultValidator")
  labResultsVerified          LabResult[]                    @relation("LabResultVerifier")
  labWorksheetsDone           LabWorksheet[]                 @relation("LabTechnician")
  riskAssessments             MaternalRiskAssessment[]       @relation("RiskAssessor")
  medicationRequests          MedicationRequest[]
  nurseAssignments            NurseAssignment[]
  nurseShifts                 NurseShift[]
  carePlansDone               NursingCarePlan[]              @relation("CarePlanCreator")
  interventionsDone           NursingIntervention[]          @relation("InterventionPerformer")
  assignedTasks               NursingTask[]                  @relation("AssignedNurse")
  completedTasks              NursingTask[]                  @relation("CompletedNurse")
  observations                Observation[]
  supervisedRecoveries        PACURecoveryRecord[]           @relation("PACUClinician")
  clinicalInterventions       PharmacyClinicalIntervention[] @relation("ClinicalPharmacist")
  prescriberInterventions     PharmacyClinicalIntervention[] @relation("PrescriberClinicalReview")
  dispensedRecords            PharmacyDispensingRecord[]     @relation("PharmacyDispenser")
  prescribedPrescriptions     PharmacyPrescription[]         @relation("PharmacyPrescriber")
  verifiedPrescriptions       PharmacyPrescription[]         @relation("PharmacyVerifier")
  loggedStockAdjustments      PharmacyStockAdjustment[]      @relation("StockAdjustmentUser")
  preAnaestheticClearances    PreAnaestheticAssessment[]     @relation("PreAnaestheticClinician")
  preOpAssessments            PreOpAssessment[]              @relation("PreOpAssessmentClinician")
  calendarBlocks              ProviderCalendarBlock[]
  loggedRadiologyIncidents    RadiologyIncident[]            @relation("RadiologyIncidentReporter")
  requestedRadiologyOrders    RadiologyOrder[]               @relation("RadiologyRequester")
  draftedRadiologyReports     RadiologyReport[]              @relation("RadiologyReporter")
  verifiedRadiologyReports    RadiologyReport[]              @relation("RadiologyVerifier")
  scheduledRadiologySchedules RadiologySchedule[]            @relation("RadiologyTechnician")
  incomingHandovers           ShiftHandover[]                @relation("IncomingNurse")
  outgoingHandovers           ShiftHandover[]                @relation("OutgoingNurse")
  user                        User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  anaesthetistBookings        SurgicalBooking[]              @relation("SurgicalBookingAnaesthetist")
  ledSurgicalBookings         SurgicalBooking[]              @relation("SurgicalBookingSurgeon")
  ledSurgicalRequests         SurgicalRequest[]              @relation("SurgicalRequestSurgeon")
  telemedicineSessions        TelemedicineSession[]          @relation("TelemedicineHost")
  triagesDone                 TriageRecord[]                 @relation("TriageCreator")
  wardNurseRosters            WardNurseRoster[]

  @@map("staff")
}

model Appointment {
  id                  String            @id @default(uuid())
  fhirId              String?           @unique
  patientId           String
  staffId             String?
  serviceType         String?
  status              AppointmentStatus @default(BOOKED)
  start               DateTime
  end                 DateTime
  reasonText          String?
  comment             String?
  appointmentNumber   String?           @unique
  appointmentType     String?
  visitType           String?
  duration            Int               @default(15)
  statusReason        String?
  isRecurring         Boolean           @default(false)
  recurrencePattern   String?
  parentAppointmentId String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  patient             Patient           @relation(fields: [patientId], references: [id])
  staff               Staff?            @relation(fields: [staffId], references: [id])

  @@index([patientId])
  @@index([staffId])
  @@index([status])
  @@index([start])
  @@map("appointments")
}

model Encounter {
  id                String          @id @default(uuid())
  fhirId            String?         @unique
  patientId         String
  staffId           String?
  visitId           String?
  status            EncounterStatus @default(PLANNED)
  class             EncounterClass  @default(AMBULATORY)
  type              String?
  serviceType       String?
  start             DateTime?
  end               DateTime?
  reasonText        String?
  diagnosis         Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  approvalSignature String?
  approvedAt        DateTime?
  approvedById      String?
  approvedBy        User?           @relation("EncounterApprover", fields: [approvedById], references: [id])
  patient           Patient         @relation(fields: [patientId], references: [id])
  staff             Staff?          @relation(fields: [staffId], references: [id])
  visit             Visit?          @relation(fields: [visitId], references: [id])

  @@map("encounters")
}

model Observation {
  id                String            @id @default(uuid())
  fhirId            String?           @unique
  patientId         String
  staffId           String?
  encounterId       String?
  status            ObservationStatus @default(FINAL)
  category          String?
  code              String
  display           String
  valueQuantity     Json?
  valueString       String?
  valueDateTime     DateTime?
  effectiveDateTime DateTime?
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  patient           Patient           @relation(fields: [patientId], references: [id])
  staff             Staff?            @relation(fields: [staffId], references: [id])

  @@map("observations")
}

model Condition {
  id                 String             @id @default(uuid())
  fhirId             String?            @unique
  patientId          String
  staffId            String?
  encounterId        String?
  clinicalStatus     ClinicalStatus     @default(ACTIVE)
  verificationStatus VerificationStatus @default(CONFIRMED)
  category           String?
  code               String
  display            String
  onsetDateTime      DateTime?
  abatementDateTime  DateTime?
  note               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  patient            Patient            @relation(fields: [patientId], references: [id])
  staff              Staff?             @relation(fields: [staffId], references: [id])

  @@map("conditions")
}

model MedicationRequest {
  id                String                  @id @default(uuid())
  fhirId            String?                 @unique
  patientId         String
  staffId           String?
  encounterId       String?
  status            MedicationRequestStatus @default(ACTIVE)
  intent            MedicationRequestIntent @default(ORDER)
  medicationCode    String?
  medicationDisplay String?
  dosageText        String?
  note              String?
  authoredOn        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  patient           Patient                 @relation(fields: [patientId], references: [id])
  staff             Staff?                  @relation(fields: [staffId], references: [id])

  @@map("medication_requests")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  changes      Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Invoice {
  id         String   @id @default(uuid())
  fhirId     String?  @unique
  patientId  String
  status     String
  total      Float
  amountPaid Float    @default(0)
  reasonText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Role {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  permissions RolePermission[]
  users       UserRoleMapping[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  module      String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleMapping {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_mappings")
}

model Department {
  id          String              @id @default(uuid())
  name        String
  code        String              @unique
  headStaffId String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  histories   DepartmentHistory[]
  members     UserDepartment[]

  @@map("departments")
}

model UserDepartment {
  userId       String
  departmentId String
  assignedAt   DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@map("user_departments")
}

model DepartmentHistory {
  id              String     @id @default(uuid())
  userId          String
  oldDepartmentId String?
  newDepartmentId String
  transferredAt   DateTime   @default(now())
  justification   String?
  department      Department @relation(fields: [newDepartmentId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("department_histories")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_histories")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model BreakGlassLog {
  id              String   @id @default(uuid())
  userId          String
  reason          String
  actionPerformed String
  accessedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("break_glass_logs")
}

model PatientCardReprint {
  id          String   @id @default(uuid())
  patientId   String
  reprintedAt DateTime @default(now())
  reprintedBy String
  reason      String?
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_card_reprints")
}

model FamilyAccount {
  id            String    @id @default(uuid())
  familyNumber  String    @unique
  headPatientId String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  members       Patient[]

  @@map("family_accounts")
}

model Visit {
  id                    String               @id @default(uuid())
  visitNumber           String               @unique
  patientId             String
  visitType             String
  status                String               @default("REGISTERED")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdBy             String?
  chiefComplaint        String?
  consultationServiceId String?
  ConsultationNote      ConsultationNote[]
  encounters            Encounter[]
  PatientQueue          PatientQueue[]
  workflowState         VisitWorkflowState?
  consultationService   ConsultationService? @relation(fields: [consultationServiceId], references: [id])
  patient               Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("visits")
}

model WorkflowTemplate {
  id          String         @id @default(uuid())
  name        String         @unique
  visitType   String
  description String?
  isDefault   Boolean        @default(false)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       WorkflowStep[]

  @@map("workflow_templates")
}

model WorkflowStep {
  id               String           @id @default(uuid())
  templateId       String
  stepOrder        Int
  statusCode       String
  label            String
  description      String?
  isOptional       Boolean          @default(false)
  isBillingGate    Boolean          @default(false)
  skipForEmergency Boolean          @default(false)
  assignedRole     String?
  module           String?
  moduleRoute      String?
  template         WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, stepOrder])
  @@map("workflow_steps")
}

model VisitWorkflowState {
  id               String   @id @default(uuid())
  visitId          String   @unique
  templateId       String
  currentStepOrder Int      @default(1)
  currentStatus    String   @default("REGISTERED")
  completedSteps   Json     @default("[]")
  updatedAt        DateTime @updatedAt
  visit            Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("visit_workflow_states")
}

model ConsultationService {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  category       String
  price          Decimal  @db.Decimal(12, 2)
  description    String?
  duration       Int      @default(15)
  isActive       Boolean  @default(true)
  requiresDoctor Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  visits         Visit[]

  @@map("consultation_services")
}

model InsuranceBenefitCatalogItem {
  id              String               @id @default(uuid())
  planId          String
  serviceCode     String
  serviceName     String
  serviceCategory String
  coverageType    String
  coveragePct     Float                @default(100)
  maxAmount       Decimal?             @db.Decimal(12, 2)
  requiresPreAuth Boolean              @default(false)
  notes           String?
  createdAt       DateTime             @default(now())
  plan            InsuranceBenefitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, serviceCode])
  @@map("insurance_benefit_catalog")
}

model Ward {
  id            String            @id @default(uuid())
  name          String            @unique
  type          String
  isActive      Boolean           @default(true)
  capacity      Int               @default(0)
  color         String?
  description   String?
  gender        String?
