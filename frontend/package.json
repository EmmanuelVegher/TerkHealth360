{
  "name": "faith-foundation-hospital",
  "productName": "Faith Foundation Hospital Management System",
  "description": "Comprehensive Hospital Management and Clinical EMR System",
  "author": "Terk-Age LTD",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node --require ./polyfill-crypto.cjs ./node_modules/vite/bin/vite.js",
    "build": "tsc && node --require ./polyfill-crypto.cjs ./node_modules/vite/bin/vite.js build",
    "build-backend": "cd ../backend && npm run build",
    "build-all": "npm run build-backend && npm run build",
    "preview": "node --require ./polyfill-crypto.cjs ./node_modules/vite/bin/vite.js preview",
    "electron": "electron ../electron-main.cjs",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron ../electron-main.cjs\"",
    "dist": "npm run build-all && electron-builder",
    "dist:win": "npm run build-all && electron-builder --win --x64",
    "dist:mac": "npm run build-all && electron-builder --mac",
    "dist:linux": "npm run build-all && electron-builder --linux"
  },
  "build": {
    "appId": "com.terkage.faithfoundationhospital",
    "productName": "Faith Foundation Hospital Management System",
    "copyright": "Copyright © 2026 Terk-Age LTD. All rights reserved.",
    "icon": "public/app-icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "polyfill-crypto.cjs",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/app-icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "resources/node.exe",
        "to": "node.exe"
      },
      {
        "from": "../backend/dist",
        "to": "backend/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/.env",
        "to": "backend/.env"
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "../backend/uploads",
        "to": "backend/uploads",
        "filter": ["**/*"]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Faith Foundation Hospital"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "compression": "normal",
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "maintainer": "Terk-Age LTD <contact@terk-age.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^3.3.2",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@types/three": "^0.185.4",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "face-api.js": "^0.22.2",
    "fhirclient": "^2.5.0",
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0",
    "notistack": "^3.0.1",
    "papaparse": "^5.5.4",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-hot-toast": "^2.4.1",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.7.4",
    "three": "^0.185.1",
    "xlsx": "^0.18.5",
    "yup": "^1.3.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  }
}
